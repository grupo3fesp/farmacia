# Copie para .env e preencha conforme a fase. O caminho local (padrão) roda sem nada disto.

# --- Servidor ---
PORT=3000
MODO=demonstracao              # demonstracao | piloto  (controla o aviso de dados fictícios)

# --- Fonte de dados ---
REPOSITORIO=local              # local | supabase
#   local    -> roda offline a partir de src/dados/seed.json (fase A)
#   supabase -> chama a RPC buscar_medicamento (requer as chaves abaixo e `npm install`)

# --- Estado de sessao (desambiguacao + deduplicacao) ---
SESSAO=memoria                 # memoria | supabase
#   memoria  -> uma instancia (dev local, servidor persistente)
#   supabase -> obrigatorio em serverless/Vercel; rode antes db/03_sessoes.sql

# --- Edicao de estoque ao vivo ---
ADMIN_TOKEN=                   # vazio = painel aberto; defina para exigir token na edicao

# --- Supabase (só quando REPOSITORIO=supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # somente backend, nunca no cliente; usada para ler indicadores

# --- IA (opcional; sem a chave, a redação cai no template determinístico) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-sonnet-5

# --- WhatsApp Cloud API (fases B e C) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=      # ID do número (teste ou oficial), diferente do número em si
WHATSAPP_VERIFY_TOKEN=         # string escolhida pela equipe, repetida no painel da Meta

# --- LGPD ---
SAL_SESSAO=troque-por-um-segredo-forte   # sal do hash do remetente; nunca gravamos o número em claro
